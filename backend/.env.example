# Copier ce fichier en ".env" et adapter les valeurs en production.

# Clé secrète pour chiffrer les sessions
SECRET_KEY=changez-moi-par-une-chaine-longue-et-aleatoire

# Origines du frontend autorisées (séparées par des virgules)
CORS_ORIGINS=https://mon-frontend.vercel.app,http://localhost:5173

# Base de données : SQLite par défaut, PostgreSQL en production
# Exemple PostgreSQL : postgresql://user:password@host:5432/fitnessdb
DATABASE_URL=sqlite:////app/database.db

# Cookies de session
SESSION_COOKIE_SAMESITE=Lax
COOKIE_SECURE=true
